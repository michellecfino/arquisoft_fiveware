# ============================================================
# .env.example — Variables de entorno requeridas por la app
# Copiar a .env y completar valores reales antes de ejecutar
# ============================================================

# Django
DJANGO_SECRET_KEY=cambiar-por-clave-segura-en-produccion
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de Datos PostgreSQL
# Obtener DB_HOST del output de Terraform: rds_endpoint
DB_NAME=disponibilidad_db
DB_USER=dbadmin
DB_PASSWORD=cambiar-por-password-seguro
DB_HOST=<rds_endpoint_sin_puerto>
DB_PORT=5432

# Redis (Heartbeat cache)
# En EC2, Redis corre localmente en localhost:6379
REDIS_URL=redis://127.0.0.1:6379/1

# AWS (para fail_db.sh)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1
